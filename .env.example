# Copy to .env. Never commit .env or paste credentials into chat.
# Gmail: use an app password, not your Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_FROM=your-address@gmail.com
SMTP_PASSWORD=your-app-password

# Optional PostgreSQL. Do not set these until the project exists.
# Supabase runtime role (SELECT/INSERT/UPDATE only), session pooler endpoint:
DATABASE_URL=
# Migration owner: direct (IPv6) or session pooler (IPv4); not for send jobs:
DATABASE_MIGRATION_URL=
